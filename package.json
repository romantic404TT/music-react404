{
  "name": "mineradio-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mineradio 2.2.0 的 React 复刻工程（Vite + React 18 + TS + Router + Tailwind + Zustand，后端全部 MSW mock）",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mock:worker": "msw init public/ --save"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "msw": "^2.7.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.7.3",
    "vite": "^5.4.19"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
